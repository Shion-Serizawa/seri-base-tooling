{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // ---------------------------------------------------------------------------
  // ルール本体は src/oxlint/base.json にある（このパッケージが配っているもの）。
  // 配る側が自分で守れていない状態を作らないため、自分にも同じものを適用する。
  //
  // 派生リポジトリでは `./node_modules/@seri/base-tooling/src/oxlint/base.json` を
  // extends する。ここだけ相対パスが違う。
  // ---------------------------------------------------------------------------
  "extends": ["./src/oxlint/base.json"],

  // ⑪ は「境界の全域を覆う override の off」を違反として見る。単一パッケージの
  // このリポジトリでは `src/**/*.ts` が事実上の全域なので、緩和は実際に必要な
  // ファイルまで狭める。狭められないものは設定ではなく実装を直す
  // （`max-statements` は printReport を分割して解消。`node/no-sync` は
  // そもそも 1 件も違反しておらず、効いていない緩和だった）。
  "overrides": [
    {
      // レポートの整形出力そのもの。stdout に書くのがこのモジュールの役目。
      "files": ["src/fitness/lib/report.ts"],
      "rules": { "no-console": "off" }
    },
    {
      // 環境変数を読む境界。ここが読むから、他の検査は process.env を見ずに済む。
      "files": ["src/fitness/lib/context.ts", "src/fitness/lib/context.test.ts"],
      "rules": { "node/no-process-env": "off" }
    }
  ],

  // extends では継承されないため（実測）、適用範囲はルートに置く。
  // ⑪ が LINT_IGNORE_PATTERNS と完全一致で固定している。
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/reports/**",
    "**/.wrangler/**",
    "**/.turbo/**",
    "**/.stryker-tmp/**",
    "**/node_modules/**",
    "**/*.gen.ts",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts"
  ]
}
